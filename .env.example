# ──────────────────────────────────────────────
# 공통 설정
# ──────────────────────────────────────────────
REQUEST_TIMEOUT=15        # HTTP 요청 타임아웃(초)
REQUEST_DELAY=1.0         # 연속 요청 사이 대기(초)
HEADLESS=true             # Playwright 브라우저 숨김 여부
REVIEW_COLLECT_LIMIT=200   # 워커가 HTTP 상품당 요청하는 리뷰 상한 (최대1000)
BROWSER_REVIEW_COLLECT_LIMIT=50  # 브라우저 기반 상품당 요청 상한

# 로컬 Postgres 접속 정보 (docker run 등으로 직접 띄운 뒤 사용)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/review_data

# 스케줄러 (기본값 그대로 써도 됩니다)
# SCHEDULE_INTERVAL_SECONDS=300          # 예약 주기
# SCHEDULE_MAX_PENDING=20                # 대기 job 상한
# SCHEDULE_FAILURE_COOLDOWN_SECONDS=21600  # 실패한 상품 재시도 대기
# SCHEDULE_EXCLUDED_PLATFORMS=gmarket,auction  # 스케줄러가 건드리지 않을 플랫폼 (차단된 곳)
# Data 독립 발굴. HTTP 플랫폼만 순환하며 큐가 쌓이면 자동으로 쉰다.
DISCOVERY_ENABLED=false
# DISCOVERY_INTERVAL_SECONDS=1800
# DISCOVERY_QUERIES_PER_CYCLE=4
# DISCOVERY_INITIAL_LIMIT=20
# DISCOVERY_LIMIT_STEP=20
# DISCOVERY_MAX_LIMIT=100
# DISCOVERY_MAX_ANALYSIS_PENDING=100
# DISCOVERY_PLATFORMS=kurly,oliveyoung,musinsa,elevenst

# 비우면 API 인증을 끕니다. 배포 환경에서는 반드시 설정하세요.
INTERNAL_TOKEN=

# docker compose 로 띄울 때만 사용. 서버에서는 반드시 바꾼다.
POSTGRES_PASSWORD=postgres

# ──────────────────────────────────────────────
# 플랫폼별 인증 정보
#
# 규칙: 자기 플랫폼에 키가 필요하면
#   1) 이 파일에 빈 값으로 추가
#   2) core/settings.py 의 Settings 에 필드 추가
#   3) 본인 collector 의 required_settings 에 추가
# 세 곳 모두 반영해야 팀원들이 뭐가 필요한지 알 수 있습니다.
# ──────────────────────────────────────────────

# 네이버 검색 API (예시)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=


# 11번가 오픈 API (정빈)
ELEVENST_API_KEY=

# Data -> AI 분석 결과 SSE. 운영 주소·계약 확인 후 true로 켠다.
AI_ANALYSIS_ENABLED=false
# AI_STREAM_URL=https://ai.re-view.kr/api/v1/data/analyze/stream
AI_STREAM_URL=
AI_INTERNAL_TOKEN=
AI_TIMEOUT_SECONDS=300
AI_MAX_REVIEWS=500
# 버전 변경 시 동일 리뷰도 재분석 대상으로 판정한다.
AI_MODEL_VERSION=
AI_POLICY_VERSION=
